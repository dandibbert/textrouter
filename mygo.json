{
  "name": "TextRouter",
  "identifier": "com.dandibbert.textrouter",
  "version": "0.2.0",
  "out": "build",
  "macos": {
    "minimumSystemVersion": "12.0",
    "infoPlist": {
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Text Document",
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.plain-text",
            "public.text"
          ]
        }
      ]
    }
  }
}
